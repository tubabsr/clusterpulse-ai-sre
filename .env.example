CLUSTER_NAME=on-prem-prod
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://rca:CHANGE_ME@postgres:5432/rca

AI_ENABLED=true
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=gpt-4.1-mini

# SMTP delivery (STARTTLS on 587 is the default)
SMTP_HOST=smtp.example.internal
SMTP_PORT=587
SMTP_USERNAME=clusterpulse@example.internal
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=clusterpulse@example.internal
SMTP_STARTTLS=true
SMTP_USE_SSL=false
EMAIL_RECIPIENTS=platform-oncall@example.internal,sre@example.internal
EMAIL_CC=
EMAIL_SEVERITY_MIN=MEDIUM

PROMETHEUS_URL=
MONITOR_EXCLUDED_NAMESPACES=kube-system,kube-public,kube-node-lease
RESTART_THRESHOLD=3
RESTART_WINDOW_MINUTES=10
PENDING_MINUTES=5
INCIDENT_COOLDOWN_MINUTES=30
LOG_TAIL_LINES=120
MAX_LOG_CHARS=12000

# Topology graph
TOPOLOGY_INCLUDE_CONFIGMAPS=true
TOPOLOGY_CACHE_SECONDS=5
TOPOLOGY_MAX_NODES=800
TOPOLOGY_MAX_PODS_PER_WORKLOAD=40
